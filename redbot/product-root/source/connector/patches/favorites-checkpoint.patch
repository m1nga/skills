+package xiaohongshu
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestRedbotCompletionRequiresObservedContinuousSourceEnd(t *testing.T) {
+	no, yes := false, true
+	p := redbotPagination{Observed: true, StartedAtBeginning: true, ChainValid: true, HasMore: &no, SeenIDs: []string{"a", "b"}}
+	feeds := []Feed{{ID: "a"}, {ID: "b"}}
+	if !redbotComplete(p, feeds) {
+		t.Fatal("complete response chain should finish after all cards arrive")
+	}
+	if redbotComplete(p, feeds[:1]) {
+		t.Fatal("network end before DOM receives final cards is not complete")
+	}
+	for _, variant := range []redbotPagination{
+		{}, {Observed: true, HasMore: &no},
+		{Observed: true, StartedAtBeginning: true, ChainValid: false, HasMore: &no},
+		{Observed: true, StartedAtBeginning: true, ChainValid: true, HasMore: &yes},
+		{Observed: true, StartedAtBeginning: true, ChainValid: true, HasMore: &no, SourceError: true},
+		{Observed: true, StartedAtBeginning: true, ChainValid: true, HasMore: &no, IncompleteResponses: 1},
+	} {
+		if redbotComplete(variant, feeds) {
+			t.Fatal("missing or failed source evidence must stay partial")
+		}
+	}
+}
+
+func TestRedbotCheckpointRetainsMoreThan2000AndIsPrivate(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "account", "scan-checkpoint.json")
+	t.Setenv("REDBOT_SCAN_CHECKPOINT", path)
+	profile := &UserProfileResponse{Feeds: make([]Feed, 2507), RedbotScan: &RedbotScan{Complete: false, EndReason: "scanning", Seen: 2507}}
+	for i := range profile.Feeds {
+		profile.Feeds[i].ID = fmt.Sprintf("%024x", i)
+	}
+	redbotCheckpoint(profile)
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var recovered UserProfileResponse
+	if err := json.Unmarshal(data, &recovered); err != nil {
+		t.Fatal(err)
+	}
+	if len(recovered.Feeds) != 2507 {
+		t.Fatalf("truncated: %d", len(recovered.Feeds))
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0600 {
+		t.Fatal("checkpoint must be private")
+	}
+	if recovered.RedbotScan.Complete {
+		t.Fatal("checkpoint count does not imply completion")
+	}
+}
