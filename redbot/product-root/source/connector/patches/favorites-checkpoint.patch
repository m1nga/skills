+package xiaohongshu
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/go-rod/rod"
+)
+
+// No card or scroll-count cap. Deadlines bound an unresponsive source; they do
+// not prove that the account has no further saves.
+const redbotScanDeadline = 30 * time.Minute
+const redbotStallDeadline = 45 * time.Second
+
+type RedbotScan struct {
+	Complete    bool                         `json:"complete"`
+	EndReason   string                       `json:"endReason"`
+	Seen        int                          `json:"seen"`
+	Diagnostics *redbotPaginationDiagnostics `json:"diagnostics,omitempty"`
+}
+
+type redbotPaginationDiagnostics struct {
+	Observed            bool              `json:"observed"`
+	HasMore             *bool             `json:"hasMore"`
+	StartedAtBeginning  bool              `json:"startedAtBeginning"`
+	ChainValid          bool              `json:"chainValid"`
+	ObservedIDs         int               `json:"observedIDs"`
+	Responses           []json.RawMessage `json:"responses,omitempty"`
+	IncompleteResponses int               `json:"incompleteResponses"`
+}
+
+type redbotPagination struct {
+	Observed            bool              `json:"observed"`
+	HasMore             *bool             `json:"hasMore"`
+	SeenIDs             []string          `json:"seenIds"`
+	StartedAtBeginning  bool              `json:"startedAtBeginning"`
+	ChainValid          bool              `json:"chainValid"`
+	SourceError         bool              `json:"sourceError"`
+	Responses           []json.RawMessage `json:"responses"`
+	IncompleteResponses int               `json:"incompleteResponses"`
+}
+
+// Observe only responses generated by the normal logged-in page. This neither
+// calls a hidden endpoint nor constructs signed requests or a pagination cursor.
+// Endpoint/schema changes fail closed: quiet DOMs remain partial inventories.
+const redbotObservePagination = `(() => {
+  const state = window.__REDBOT_PAGINATION__ = {observed:false, hasMore:null, seenIds:[], startedAtBeginning:false, chainValid:false, nextCursor:'', sourceError:false, responses:[], incompleteResponses:0};
+  const accept = (url, payload) => {
+    let parsed; try { parsed = new URL(url, location.href); } catch { return; }
+    if (parsed.pathname.startsWith('/api/sns/web/') && parsed.pathname.includes('/collect/')) {
+      const d = payload && payload.data; const notes = d && d.notes;
+      state.responses.push({path:parsed.pathname, keys:payload && typeof payload === 'object' ? Object.keys(payload).slice(0,20) : [], dataType:Array.isArray(d) ? 'array' : d === null ? 'null' : typeof d, dataKeys:d && typeof d === 'object' ? Object.keys(d).slice(0,20) : [], success:payload && payload.success === true, hasMoreType:typeof (d && d.has_more), hasMore:typeof (d && d.has_more) === 'boolean' ? d.has_more : null, cursorType:typeof (d && d.cursor), count:Array.isArray(notes) ? notes.length : null, noteKeys:Array.isArray(notes) && notes.length && notes[0] ? Object.keys(notes[0]).slice(0,20) : []});
+      state.responses = state.responses.slice(-12);
+    }
+    if (!/^\/api\/sns\/web\/v[12]\/(?:note|user)\/collect\/page$/.test(parsed.pathname)) return;
+    if (!payload || payload.success !== true) { state.sourceError = true; return; }
+    const d = payload.data;
+    if (!d || typeof d.has_more !== 'boolean' || !Array.isArray(d.notes)) { state.incompleteResponses++; return; }
+    const ids = d.notes.map(n => n && (n.note_id || n.id));
+    if (ids.some(id => typeof id !== 'string' || !/^[a-f0-9]{24}$/.test(id))) { state.incompleteResponses++; return; }
+    const cursor = parsed.searchParams.get('cursor') || '';
+    if (!cursor) Object.assign(state, {seenIds:[], startedAtBeginning:true, chainValid:true});
+    else if (!state.startedAtBeginning || cursor !== state.nextCursor) state.chainValid = false;
+    if (d.has_more && (typeof d.cursor !== 'string' || !d.cursor)) state.chainValid = false;
+    Object.assign(state, {observed:true, hasMore:d.has_more, seenIds:[...new Set([...state.seenIds, ...ids])], nextCursor:d.cursor, sourceError:false, incompleteResponses:0});
+  };
+  const originalFetch = window.fetch;
+  window.fetch = function(...args) {
+    return originalFetch.apply(this, args).then(response => {
+      const url = response.url || (args[0] && args[0].url) || args[0];
+      if (String(url).includes('/api/sns/web/') && String(url).includes('/collect/')) response.clone().json().then(data => accept(url, data)).catch(() => {});
+      return response;
+    });
+  };
+  const originalOpen = XMLHttpRequest.prototype.open;
+  const originalSend = XMLHttpRequest.prototype.send;
+  XMLHttpRequest.prototype.open = function(method, url, ...args) { this.__redbotURL = url; return originalOpen.call(this, method, url, ...args); };
+  XMLHttpRequest.prototype.send = function(...args) {
+    this.addEventListener('load', () => {
+      try { if (String(this.__redbotURL).includes('/api/sns/web/') && String(this.__redbotURL).includes('/collect/')) accept(this.responseURL || this.__redbotURL, this.responseType === 'json' ? this.response : JSON.parse(this.responseText)); } catch {}
+    }, {once:true});
+    return originalSend.apply(this, args);
+  };
+})();`
+
+func redbotComplete(p redbotPagination, feeds []Feed) bool {
+	if !p.Observed || !p.StartedAtBeginning || !p.ChainValid || p.HasMore == nil || *p.HasMore || p.SourceError || p.IncompleteResponses > 0 {
+		return false
+	}
+	seen := make(map[string]bool, len(feeds))
+	for _, feed := range feeds {
+		seen[feed.ID] = true
+	}
+	for _, id := range p.SeenIDs {
+		if !seen[id] {
+			return false
+		}
+	}
+	return true
+}
+
+func (u *UserProfileAction) redbotReadFavorites(ctx context.Context, page *rod.Page) (*UserProfileResponse, error) {
+	started, changed := time.Now(), time.Now()
+	lastCount := -1
+	var latest *UserProfileResponse
+	for {
+		profile, err := u.extractUserProfileData(page, TabFavorites)
+		if err != nil {
+			return nil, err
+		}
+		if profile.Feeds == nil {
+			profile.Feeds = []Feed{}
+		}
+		latest = profile
+		if len(profile.Feeds) != lastCount {
+			changed = time.Now()
+		}
+		var pagination redbotPagination
+		if result, err := page.Eval(`() => JSON.stringify(window.__REDBOT_PAGINATION__ || {})`); err == nil {
+			_ = json.Unmarshal([]byte(result.Value.String()), &pagination)
+		}
+		scan := &RedbotScan{Seen: len(profile.Feeds), EndReason: "scanning"}
+		scan.Diagnostics = &redbotPaginationDiagnostics{Observed: pagination.Observed, HasMore: pagination.HasMore, StartedAtBeginning: pagination.StartedAtBeginning, ChainValid: pagination.ChainValid, ObservedIDs: len(pagination.SeenIDs), Responses: pagination.Responses, IncompleteResponses: pagination.IncompleteResponses}
+		switch {
+		case redbotComplete(pagination, profile.Feeds):
+			scan.Complete, scan.EndReason = true, "source_end"
+		case ctx.Err() != nil:
+			scan.EndReason = "cancelled"
+		case pagination.SourceError:
+			scan.EndReason = "source_error"
+		case pagination.IncompleteResponses > 0:
+			scan.EndReason = "source_response_incomplete"
+		case time.Since(started) >= redbotScanDeadline-5*time.Second:
+			scan.EndReason = "deadline"
+		case time.Since(changed) >= redbotStallDeadline:
+			if pagination.IncompleteResponses > 0 {
+				scan.EndReason = "source_response_incomplete"
+			} else {
+				scan.EndReason = "stalled"
+			}
+		}
+		profile.RedbotScan = scan
+		if len(profile.Feeds) != lastCount || scan.EndReason != "scanning" {
+			redbotCheckpoint(profile)
+		}
+		lastCount = len(profile.Feeds)
+		if scan.EndReason != "scanning" {
+			return profile, nil
+		}
+		// Move the normal page's scroll container to its current end. Lazy loading
+		// remains owned by Xiaohongshu; this does not mutate favorites.
+		if _, err := page.Eval(`() => {
+			const cards = document.querySelectorAll('section.note-item');
+			const last = cards[cards.length - 1];
+			if (last) { last.scrollIntoView({block:'end'}); let p = last.parentElement;
+				while (p && p !== document.body) { if (p.scrollHeight > p.clientHeight && /auto|scroll/.test(getComputedStyle(p).overflowY)) p.scrollTop = p.scrollHeight; p = p.parentElement; }
+			}
+			// A masonry layout's final DOM card can be shorter than its neighbours.
+			// Finish at the actual document bottom after scrollIntoView, not above it.
+			window.scrollTo(0, document.documentElement.scrollHeight);
+		}`); err != nil {
+			return nil, err
+		}
+		select {
+		case <-ctx.Done():
+			latest.RedbotScan = &RedbotScan{Seen: len(latest.Feeds), EndReason: "cancelled"}
+			redbotCheckpoint(latest)
+			return latest, nil
+		case <-time.After(800 * time.Millisecond):
+		}
+	}
+}
+
+// Host-configured private path; source tokens never go to a public endpoint.
+func redbotCheckpoint(profile *UserProfileResponse) {
+	path := os.Getenv("REDBOT_SCAN_CHECKPOINT")
+	if path == "" {
+		return
+	}
+	data, err := json.Marshal(profile)
+	if err != nil {
+		return
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return
+	}
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, data, 0600); err != nil {
+		return
+	}
+	_ = os.Rename(tmp, path)
+}
