+	// RedBot: bounded read-only inventory with a private recovery checkpoint.
+	// Stagnation is NOT proof of complete coverage; callers must label it partial.
+	if tab == TabFavorites {
+		last, stagnant := -1, 0
+		for i := 0; i < 100; i++ {
+			profile, err := u.extractUserProfileData(page, tab)
+			if err != nil { return nil, err }
+			n := len(profile.Feeds)
+			redbotCheckpoint(profile)
+			if n >= 2000 { return profile, nil }
+			if n == last { stagnant++ } else { stagnant = 0 }
+			if stagnant >= 5 { return profile, nil }
+			last = n
+			if ctx.Err() != nil { return profile, nil }
